NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

N8N_WEBHOOK_SECRET=replace-me
N8N_ATTENDANCE_WEBHOOK_URL=
INTEGRATION_OAUTH_STATE_SECRET=replace-me-long-random-string

# SMS (used by n8n attendance follow-up workflow)
SMS_MOBILE_API_URL=
SMS_MOBILE_API_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email (church onboarding invites)
RESEND_API_KEY=
# Use onboarding@resend.dev until you verify faithform.io in Resend
# Production: RESEND_FROM_EMAIL=noreply@faithform.io
RESEND_FROM_EMAIL=onboarding@resend.dev

# Google OAuth (Calendar + Gmail drafts)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Production: GOOGLE_REDIRECT_URI=https://faithform.io/api/integrations/google/callback

# Facebook Page posting
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/integrations/facebook/callback
# Production: FACEBOOK_REDIRECT_URI=https://faithform.io/api/integrations/facebook/callback

# Placid.app (event social graphics)
PLACID_API_TOKEN=
PLACID_TEMPLATE_GENERAL=
# PLACID_TEMPLATE_YOUTH=
# PLACID_TEMPLATE_OUTREACH=
# PLACID_TEMPLATE_WORSHIP_NIGHT=

# Rotate keys if they were ever exposed in chat or logs
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OPENAI_MODEL=gpt-4o

ESV_API_KEY=your-esv-api-key

# Retell AI (voice assistant phone agents)
RETELL_API_KEY=
# Optional: default voice from your Retell dashboard (e.g. 11labs-Adrian, retell-Cimo)
RETELL_DEFAULT_VOICE_ID=11labs-Adrian

# Stripe Connect (giving)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxx
# Optional: second destination during thin/snapshot migration (each whsec_ is unique)
# STRIPE_WEBHOOK_SECRET_SNAPSHOT=whsec_xxxxxxxxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET_THIN=whsec_xxxxxxxxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRETS=whsec_snapshot...,whsec_thin...
PLATFORM_APPLICATION_FEE_AMOUNT=0
# Main app URL (give links, Stripe Connect return URLs, emails)
# Production: NEXT_PUBLIC_SITE_URL=https://faithform.io
# Optional: only if you own a dedicated give subdomain AND set NEXT_PUBLIC_GIVE_USE_DEDICATED_HOST=true
# NEXT_PUBLIC_GIVE_HOST=give.faithform.io
# NEXT_PUBLIC_GIVE_USE_DEDICATED_HOST=true
