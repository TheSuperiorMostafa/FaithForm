NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

N8N_WEBHOOK_SECRET=replace-me
INTEGRATION_OAUTH_STATE_SECRET=replace-me-long-random-string
# Required in production — HMAC for donor portal session cookies (32+ random bytes)
DONOR_PORTAL_SESSION_SECRET=replace-me-long-random-string
# Required for privacy-safe rate-limit keys; separate from every other secret
RATE_LIMIT_KEY_SECRET=replace-me-long-random-string
# Trust X-Forwarded-For only behind a proxy that overwrites it (Vercel is automatic)
# TRUST_PROXY_HEADERS=true

# Attendance follow-up SMS (SMSMobileAPI — install app on sending phone)
SMS_MOBILE_API_KEY=
# Optional Twilio fallback if SMS_MOBILE_API_KEY is not set:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
STREAM_RELAY_HOST=stream.faithform.io
NEXT_PUBLIC_STREAM_RELAY_HOST=stream.faithform.io
STREAM_RELAY_WEBHOOK_SECRET=replace-me-long-random-string
STREAM_RELAY_PLAYBACK_SECRET=replace-me-separate-long-random-string
# Separate short-lived browser-ingest capability signing authority
STREAM_INGEST_SIGNING_SECRET=replace-me-long-random-string
# Server-only HLS proxy upstream (named Cloudflare tunnel or direct :8888)
STREAM_HLS_UPSTREAM_URL=https://hls.stream.faithform.io
# Browser studio WebSocket ingest (ws-ingest.py on relay port 8090)
STREAM_WS_INGEST_UPSTREAM_URL=wss://ingest.stream.faithform.io
# WHIP/WebRTC browser publish (proxied via /api/stream/whip)
STREAM_WHIP_UPSTREAM_URL=
# Cron auth for /api/stream/scheduled-start and syndication retry (Vercel sets CRON_SECRET)
STREAM_CRON_SECRET=replace-me-long-random-string
# Required for the Monday announcement Gmail draft cron (vercel.json → crons).
# Vercel injects this value as `Authorization: Bearer <CRON_SECRET>` on cron
# invocations, so the name must be exactly CRON_SECRET.
CRON_SECRET=replace-me-long-random-string
# Required, separate viewer-only playback signing authority
STREAM_PLAYBACK_SECRET=replace-me-long-random-string

# Transactional email (church onboarding invites)
RESEND_API_KEY=
# Use onboarding@resend.dev until you verify faithform.io in Resend
# Production: RESEND_FROM_EMAIL=noreply@faithform.io
RESEND_FROM_EMAIL=onboarding@resend.dev

# Google OAuth (Calendar + Gmail drafts)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Production: GOOGLE_REDIRECT_URI=https://faithform.io/api/integrations/google/callback

# Facebook Page posting
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/integrations/facebook/callback
# Production: FACEBOOK_REDIRECT_URI=https://faithform.io/api/integrations/facebook/callback


# YouTube Live API (auto-provisions the RTMP destination when you go live).
#
# Leave all three BLANK to reuse the Google OAuth client above — that is the
# simplest setup and needs no extra redirect URI. Just make sure the Google
# Cloud project has the "YouTube Data API v3" enabled.
#
# Only set these to run YouTube through a separate OAuth client. If you set
# YOUTUBE_REDIRECT_URI, that exact URL must also be registered as an authorised
# redirect URI on the client, or Google rejects the connect with
# `redirect_uri_mismatch` (and the token exchange with `invalid_grant`).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=https://faithform.io/api/integrations/youtube/callback
# Placid.app (event social graphics)
PLACID_API_TOKEN=
PLACID_TEMPLATE_GENERAL=
# PLACID_TEMPLATE_YOUTH=
# PLACID_TEMPLATE_OUTREACH=
# PLACID_TEMPLATE_WORSHIP_NIGHT=

# Rotate keys if they were ever exposed in chat or logs
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional: timeout (ms) before OpenAI image gen is abandoned for the next fallback
# OPENAI_IMAGE_TIMEOUT_MS=45000

# Announcement Facebook graphic image generation.
# Gemini 2.5 Flash Image ("Nano Banana") is fast and used first when set.
# IMAGE_PROVIDER controls selection: "gemini", "openai", or leave unset for
# auto (Gemini first, OpenAI fallback).
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# IMAGE_PROVIDER=
# Optional: timeout (ms) before Gemini image gen falls back to the next provider
# GEMINI_IMAGE_TIMEOUT_MS=45000

ESV_API_KEY=your-esv-api-key

# Retell AI (voice assistant phone agents)
RETELL_API_KEY=
# Optional: default voice from your Retell dashboard (e.g. 11labs-Adrian, retell-Cimo)
RETELL_DEFAULT_VOICE_ID=11labs-Adrian

# Stripe Connect (giving)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxx
# Optional: second destination during thin/snapshot migration (each whsec_ is unique)
# STRIPE_WEBHOOK_SECRET_SNAPSHOT=whsec_xxxxxxxxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET_THIN=whsec_xxxxxxxxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRETS=whsec_snapshot...,whsec_thin...
PLATFORM_APPLICATION_FEE_AMOUNT=0
# Main app URL (give links, Stripe Connect return URLs, emails)
# Production: NEXT_PUBLIC_SITE_URL=https://faithform.io
# Optional: only if you own a dedicated give subdomain AND set NEXT_PUBLIC_GIVE_USE_DEDICATED_HOST=true
# NEXT_PUBLIC_GIVE_HOST=give.faithform.io
# NEXT_PUBLIC_GIVE_USE_DEDICATED_HOST=true

# ---------------------------------------------------------------------------
# CHURCH WEBSITES (multi-tenant public sites)
# ---------------------------------------------------------------------------
# Root host that church subdomains hang off. With this set to faithform.io,
# grace.faithform.io renders the church whose slug is "grace" -- resolved from
# the hostname alone, with no database lookup.
# Leave unset to disable subdomain routing; custom domains in site_domains
# still resolve either way.
# Production: NEXT_PUBLIC_SITE_ROOT_HOST=faithform.io
# Local testing: NEXT_PUBLIC_SITE_ROOT_HOST=localtest.me
#   (*.localtest.me resolves to 127.0.0.1, so grace.localtest.me:3000 works
#    with no /etc/hosts editing)
# NEXT_PUBLIC_SITE_ROOT_HOST=

# ---------------------------------------------------------------------------
# CUSTOM DOMAINS
# ---------------------------------------------------------------------------
# The records a church is told to add at their registrar. Defaults are Vercel's
# published targets; change them only if the app moves off Vercel.
# SITE_DNS_A_RECORD=76.76.21.21
# SITE_DNS_CNAME_TARGET=cname.vercel-dns.com

# Optional. With both set, connecting a domain registers the hostname against
# the Vercel project automatically and the app can read back whether it is
# actually serving. Leave unset and provisioning stays manual: churches still
# get their DNS records and a real DNS check, and a platform admin adds the
# hostname to the project, then marks it live from /admin/domains.
# Token needs the "Domains" scope on the project.
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# Who gets told when a church asks for a domain. Comma-separated.
# Falls back to BOOTSTRAP_SUPERADMIN_EMAILS when unset.
# DOMAIN_REQUEST_NOTIFY_EMAIL=

# Support runs on one mailbox in both directions: our doorbell, the church's
# receipt, and every reply we post. Both default to support@faithform.io, so
# these only need setting to route somewhere else. Comma-separated.
# Support tickets never send SMS — the only line we could text from is the
# church's own handset, which is not who a support notice should come from.
SUPPORT_NOTIFY_EMAIL=
SUPPORT_FROM_EMAIL=

# --- Push notifications for the member app ------------------------------
# Absent from this file until now, which is how a deployment could pass
# `pnpm pilot:readiness` with Android push configured and every iPhone
# silently receiving nothing. Both halves are needed; neither is a fallback
# for the other. The adapters report `not_configured` and skip rather than
# failing, so missing values look like silence, not an error.
#
# Apple: create an APNs .p8 key in the Apple Developer account (one key
# covers every app and does not expire). The key file itself never belongs
# in this repository — `pnpm scan:secrets` fails if it appears.
APNS_KEY_ID=
APNS_TEAM_ID=
# The .p8 contents, newlines included.
APNS_PRIVATE_KEY=
# The app bundle id, e.g. io.faithform.faithful
APNS_TOPIC=
#
# Google: a Firebase service account for the project the Android app ships
# against. FCM_SERVICE_ACCOUNT_JSON may carry the whole JSON instead of the
# three separate values.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Faithful check-in signing (Prompt 8)
# ---------------------------------------------------------------------------
# Signs the rotating QR codes, the projector's read-only display capability,
# the one-time pairing codes, and the kiosk credentials. Each purpose derives
# its own sub-key from this value, so one variable covers all four without any
# of them being interchangeable.
#
# Required in production. Without it there is no QR check-in, no short-code
# fallback, and no kiosk mode — the dashboard says so rather than failing at
# the church.
#
# At least 32 characters, and never shared with any other secret in this file.
# Generate with: openssl rand -base64 48
ATTENDANCE_QR_SECRET=replace-me-long-random-string

# Set only while rotating. Move the outgoing value here, install a new one
# above, and remove this line once the longest-lived capability has expired —
# a kiosk session, which never outlives its service by more than an hour.
# Codes signed by the previous key keep verifying while this is present and
# stop the moment it is removed. It is never used to sign anything new.
# ATTENDANCE_QR_SECRET_PREVIOUS=
