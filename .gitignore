# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
.env.local.bak
.env.vercel*
.env.production*

# provider keys. An APNs .p8 is downloadable exactly once and is the whole
# credential for sending to every iPhone; a Firebase service account is the
# same for Android. Neither belongs in a repository, and a key that reaches
# one has to be revoked rather than removed.
*.p8
service-account*.json
google-services.json

# vercel
.vercel

# local scratch output (report comparisons, render snapshots)
/.tmp/

# typescript
*.tsbuildinfo
next-env.d.ts

# self-hosted bible JSON (copyright — generate locally, do not commit)
/data/bible/*.json

# optimized sermon theme images (uploaded to Supabase, not committed)
/data/sermon-theme-import/

# Python bytecode from relay script checks
__pycache__/

# Native build outputs
apps/faithform-android/.gradle/
apps/faithform-android/.kotlin/
apps/faithform-android/build/
apps/faithform-android/**/build/
apps/faithform-android/local.properties
apps/faithform-ios/.build/
apps/faithform-ios/.swiftpm/
apps/faithform-ios/*.xcodeproj/xcuserdata/

# Xcode build output (each worktree grows its own multi-GB DerivedData tree)
apps/faithform-ios/build/

# Agent worktrees live here; their branches are pushed, the checkouts are not
.claude/worktrees/

# Supabase CLI scratch state
supabase/.temp/
