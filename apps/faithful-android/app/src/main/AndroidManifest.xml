<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Runtime permission from API 33. Requested only after the education
        screen and an explicit tap — never at launch.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Automatic attendance (Prompt 7).

        Exactly three permissions, and no more. Each is requested progressively,
        after its own explanation, and never at launch:

          * ACCESS_COARSE_LOCATION - declared because Android 12+ lets a person
            answer the same dialog with "approximate". The app must be able to
            recognise that state and explain it, which it cannot do if the
            permission is undeclared.
          * ACCESS_FINE_LOCATION - a campus radius is 100-300 m; approximate
            location is city-block accurate and cannot resolve one.
          * ACCESS_BACKGROUND_LOCATION - check-in happens while someone is
            settling into a seat, not looking at their phone. Without this the
            OS delivers no transition and the feature silently never fires.

        Deliberately absent, and asserted by a forbidden-symbol sweep:

          * No FOREGROUND_SERVICE / FOREGROUND_SERVICE_LOCATION. There is no
            permanent service and no continuous tracking; the system does the
            monitoring and wakes a receiver.
          * No ACTIVITY_RECOGNITION, no advertising id, no analytics permission.

        RECEIVE_BOOT_COMPLETED is required because geofences do not survive a
        reboot and must be re-registered.
    -->
    <!--
        QR check-in (Prompt 8).

        Requested only after an explicit tap on "Scan the code" — never at
        launch, never during onboarding, never while browsing a feed, and never
        when enabling automatic attendance. `CheckInScanCoordinator` is the only
        caller and it is reachable from that button alone.

        Deliberately absent, and asserted by a forbidden-symbol sweep:

          * No READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE. Faithful reads a
            string off a screen; it has no reason to touch the photo library and
            no way to save a frame.
          * No WRITE_EXTERNAL_STORAGE, no `ImageCapture`, no `VideoCapture`.

        The camera is `required="false"` so a device without one can still
        install Faithful and use the typed code instead.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".FaithfulApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Faithful"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Faithful">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Custom-scheme links. Every one is parsed and authorized before
                any state changes; an unknown or unauthorized link is refused.
                App Links over https need a verified Digital Asset Links file on
                a domain this repository does not yet establish, so they are
                deliberately not declared here — see the external setup runbook.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="faithful" />
            </intent-filter>
        </activity>

        <!--
            Geofence transitions.

            android:exported="false" is the security boundary: only the system
            and Play services may deliver to it, and no other app can forge a
            transition. The PendingIntent that targets it is created with
            FLAG_MUTABLE (required from API 31, and required by the geofencing
            API, which fills in the transition extras) plus an explicit
            component, so it cannot be redirected elsewhere.

            android:directBootAware is deliberately absent: this receiver needs
            the encrypted store, which is unavailable before first unlock.
        -->
        <receiver
            android:name=".attendance.GeofenceBroadcastReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
            Re-registration after a reboot or an app update.

            Geofences are not restored after a device reboot - the app must
            listen for BOOT_COMPLETED and re-register. They *are* restored after
            a Play services upgrade, so that case needs nothing.
            MY_PACKAGE_REPLACED covers an app update.
        -->
        <receiver
            android:name=".attendance.BootAndUpdateReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".attendance.PackageReplacedReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
