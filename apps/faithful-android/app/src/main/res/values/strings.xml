    <!-- Automatic attendance (Prompt 7) -->
    <string name="auto_attendance_title">Automatic check-in</string>
    <string name="auto_attendance_intro_title">Let your church know you were there</string>
    <string name="auto_attendance_intro_body">When you arrive for a service, FaithForm can check you in without you doing anything. Your church sees that you attended — nothing about where else you go.</string>
    <string name="auto_attendance_privacy_title">What FaithForm does with your location</string>
    <string name="auto_attendance_privacy_point_one">Your phone watches for your church, and tells FaithForm only when you arrive.</string>
    <string name="auto_attendance_privacy_point_two">FaithForm never keeps a record of where you have been.</string>
    <string name="auto_attendance_privacy_point_three">Your church sees that you attended a service. It never sees your location.</string>
    <string name="auto_attendance_privacy_point_four">You can turn this off at any time, and everything stops.</string>
    <string name="auto_attendance_foreground_title">FaithForm needs to see your location</string>
    <string name="auto_attendance_foreground_body">To know when you have arrived, FaithForm needs permission to read your location. Your phone will ask you next.</string>
    <string name="auto_attendance_background_title">And to notice while the app is closed</string>
    <string name="auto_attendance_background_body">Check-in happens while you are settling into a seat, not staring at your phone. For that, your phone needs to allow location all the time. FaithForm only ever looks at whether you have arrived at your church.</string>
    <string name="auto_attendance_continue">Continue</string>
