<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext is off everywhere. The debug build talks to a local dev server on
    the emulator loopback address, which is the single documented exception and
    exists only in the debug manifest's base config below.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
