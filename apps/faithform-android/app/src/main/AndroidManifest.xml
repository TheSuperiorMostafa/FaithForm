<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <!-- Chat attachments use the system picker. Remove unused SDK permissions. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Stream uses WorkManager for short message synchronization jobs. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        Version one declares what version one uses, and nothing it does not.

        A declared permission is a promise on the Play listing and in the Data
        safety form, whether or not any code ever asks for it. So three that
        belong to features which are built but not shipped in v1 are not here:

          * POST_NOTIFICATIONS - push arrives in v1.1. Declaring it now would
            list notifications on the store page for an app that sends none.
          * ACCESS_BACKGROUND_LOCATION - automatic (geofence) attendance is out
            of scope for v1. Background location is also the one permission
            Google Play reviews by hand and requires a video and a declaration
            for; asking reviewers to approve a feature nobody can reach would
            be asking them to approve a promise.
          * RECEIVE_BOOT_COMPLETED - existed only to re-register geofences
            after a reboot.

        The geofence code still compiles and is still tested, but no receiver
        for it is registered below, so nothing can wake it. Turning automatic
        attendance on is a manifest change, reviewed as one.

        Deliberately absent in every version, and asserted by the manifest tests:

          * No FOREGROUND_SERVICE of any type. There is no permanent service.
          * No ACTIVITY_RECOGNITION, no advertising id, no analytics permission.
    -->

    <!--
        Nearby churches.

        Foreground only, requested once, after the education screen and an
        explicit tap on "Churches near me" - never at launch. COARSE is declared
        because Android 12+ lets a person answer the same dialog with
        "approximate", and the app must accept that answer rather than refuse
        it. FINE is what makes "near me" mean the right town.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
        QR check-in.

        Requested only after an explicit tap on "Scan the code" - never at
        launch, never during onboarding, never while browsing a feed.
        `CameraXScanner` is the only file that can raise the dialog, and it is
        reachable from that button alone.

        Deliberately absent, and asserted by a forbidden-symbol sweep:

          * No READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE. FaithForm reads a
            string off a screen; it has no reason to touch the photo library and
            no way to save a frame.
          * No WRITE_EXTERNAL_STORAGE, no `ImageCapture`, no `VideoCapture`.

        The camera is `required="false"` so a device without one can still
        install FaithForm and use the typed code instead.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
        Package visibility (Android 11+).

        From API 30 an app cannot see which other apps can handle an intent
        unless it says which intents it will ask about. Without this, the
        "Open Mail" button on the check-your-email screen resolves to nothing
        and is hidden on every modern phone. One narrow intent, not
        QUERY_ALL_PACKAGES - FaithForm has no business with the full app list.

        Web links (privacy policy, terms, account deletion) need no entry: they
        are started directly and a missing browser is caught, rather than
        resolved first.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_EMAIL" />
        </intent>
    </queries>

    <application
        android:name=".FaithFormApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FaithForm"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FaithForm.Starting">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Custom-scheme links. Every one is parsed and authorized before
                any state changes; an unknown or unauthorized link is refused.
                App Links over https need a verified Digital Asset Links file on
                a domain this repository does not yet establish, so they are
                deliberately not declared here - see the external setup runbook.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="faithform" />
            </intent-filter>
        </activity>

        <!--
            No receivers are registered in v1.

            `GeofenceBroadcastReceiver`, `BootAndUpdateReceiver` and
            `PackageReplacedReceiver` exist in source for automatic attendance,
            which v1 does not ship. When it does, they come back here exactly
            as they were: the geofence receiver `exported="false"` so only the
            system and Play services can deliver a transition, and the boot
            receiver guarded by the RECEIVE_BOOT_COMPLETED permission only the
            system holds.
        -->
    </application>
</manifest>
