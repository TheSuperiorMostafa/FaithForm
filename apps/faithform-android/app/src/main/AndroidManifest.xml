<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Every permission here names a feature a person can reach in 1.0, and
        each runtime permission is asked for only after its explanation and a
        tap - never at launch.

        Deliberately absent in every version, and asserted by the manifest tests:

          * No FOREGROUND_SERVICE of any type. There is no permanent service;
            WorkManager's own foreground service and its permission are removed
            below, because nothing here ever runs as one.
          * No ACTIVITY_RECOGNITION, no advertising id, no analytics permission.
    -->

    <!--
        Nearby churches.

        Foreground only, requested once, after the education screen and an
        explicit tap on "Churches near me" - never at launch. COARSE is declared
        because Android 12+ lets a person answer the same dialog with
        "approximate", and the app must accept that answer rather than refuse
        it. FINE is what makes "near me" mean the right town.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
        Automatic check-in.

        A person who turns it on is checked in when they arrive at their church
        for a service, even when the app is closed. The system watches the
        campus boundary and wakes a receiver; the app reads one location only
        after the phone has stayed and the server says a service is open.

          * ACCESS_BACKGROUND_LOCATION - without it Android delivers no geofence
            transition while the app is closed, and the feature never fires.
            Requested only after the prominent disclosure screen, which names
            the data, the purpose and that it is not shared. On Android 11+ the
            request opens Settings, where the person chooses "Allow all the
            time". COARSE and FINE above are its prerequisites.
          * RECEIVE_BOOT_COMPLETED - geofences do not survive a reboot and are
            registered again. WorkManager needs it too, to restore scheduled
            work.
          * POST_NOTIFICATIONS - "You're checked in" and, for a church that
            asks, "Are you at church?". Requested on Android 13+ from its own
            explanation screen, after the feature is on.
          * WAKE_LOCK - WorkManager holds one only while a check-in is being
            sent. It is a normal permission and shows nothing to the person.
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />

    <!--
        QR check-in.

        Requested only after an explicit tap on "Scan the code" - never at
        launch, never during onboarding, never while browsing a feed.
        `CameraXScanner` is the only file that can raise the dialog, and it is
        reachable from that button alone.

        Deliberately absent, and asserted by a forbidden-symbol sweep:

          * No READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE. FaithForm reads a
            string off a screen; it has no reason to touch the photo library and
            no way to save a frame.
          * No WRITE_EXTERNAL_STORAGE, no `ImageCapture`, no `VideoCapture`.

        The camera is `required="false"` so a device without one can still
        install FaithForm and use the typed code instead.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
        Package visibility (Android 11+).

        From API 30 an app cannot see which other apps can handle an intent
        unless it says which intents it will ask about. Without this, the
        "Open Mail" button on the check-your-email screen resolves to nothing
        and is hidden on every modern phone. One narrow intent, not
        QUERY_ALL_PACKAGES - FaithForm has no business with the full app list.

        Web links (privacy policy, terms, account deletion) need no entry: they
        are started directly and a missing browser is caught, rather than
        resolved first.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_EMAIL" />
        </intent>
        <!--
            Google Play services, and only it: clearing its data silently drops
            every geofence, and the broadcast that says so is filtered out for a
            package this app cannot see.
        -->
        <package android:name="com.google.android.gms" />
    </queries>

    <application
        android:name=".FaithFormApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FaithForm"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FaithForm.Starting">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Custom-scheme links. Every one is parsed and authorized before
                any state changes; an unknown or unauthorized link is refused.
                App Links over https need a verified Digital Asset Links file on
                a domain this repository does not yet establish, so they are
                deliberately not declared here - see the external setup runbook.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="faithform" />
            </intent-filter>
        </activity>

        <!--
            Geofence transitions.

            android:exported="false" is the security boundary: only the system
            and Play services may deliver to it, and no other app can forge a
            transition. The PendingIntent that targets it is created with
            FLAG_MUTABLE (required from API 31, and by the geofencing API, which
            fills in the transition extras) plus an explicit component, so it
            cannot be redirected elsewhere.

            android:directBootAware is deliberately absent: this receiver needs
            the encrypted store, which is unavailable before first unlock.
        -->
        <receiver
            android:name=".attendance.GeofenceBroadcastReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
            Re-registration after a reboot.

            Geofences are not restored after a device reboot - the app must
            listen for BOOT_COMPLETED and register them again. Exported only
            because nothing else hears BOOT_COMPLETED, and guarded by
            RECEIVE_BOOT_COMPLETED, which only the system holds.
        -->
        <receiver
            android:name=".attendance.BootAndUpdateReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Re-registration after this app is updated. The broadcast is system-only. -->
        <receiver
            android:name=".attendance.PackageReplacedReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Re-registration after Google Play services' data is cleared. System-only. -->
        <receiver
            android:name=".attendance.GeofencingResetReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_DATA_CLEARED" />
                <data android:scheme="package" android:ssp="com.google.android.gms" />
            </intent-filter>
        </receiver>

        <!--
            The "Check in" button on "Are you at church?". Reached only through
            this app's own immutable PendingIntent, which names it explicitly.
        -->
        <receiver
            android:name=".attendance.AttendanceNotificationReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
            WorkManager's foreground service, removed. Check-in work is
            one-time, never expedited and never promoted to a foreground
            service, so the service could only ever be dead weight - and a
            declared foreground service is a question in Play review.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />
    </application>
</manifest>
