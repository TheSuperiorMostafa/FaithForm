// Values every configuration shares.
//
// **Public values only.** An origin, an environment key and a build number.
// Nothing here is a secret, and nothing secret may ever be added: an app bundle
// is readable by anyone who installs it.

// Your own settings, if you have any.
//
// `#include?` is the optional form: the file does not have to exist, and this
// one is gitignored. It is where a Team ID and a bundle prefix belong — both are
// yours, neither is a secret, and neither belongs in a shared repository.
//
//     apps/faithform-ios/App/Configuration/Local.xcconfig
//     DEVELOPMENT_TEAM = ABCDE12345
//     FAITHFORM_BUNDLE_ID = com.yourname.faithform
//
// Included first so everything below can be overridden by it.
#include? "Local.xcconfig"

// The App ID registered with Apple, and the same applicationId the Android app
// ships under. Debug and Staging append a suffix so all three install side by
// side on one phone.
//
// Someone building on their own Apple team cannot sign `io.faithform.app`; they
// set FAITHFORM_BUNDLE_ID in Local.xcconfig to something they own.
FAITHFORM_BUNDLE_ID = $(FAITHFORM_BUNDLE_ID:default=io.faithform.app)
PRODUCT_BUNDLE_IDENTIFIER = $(FAITHFORM_BUNDLE_ID)$(FAITHFORM_BUNDLE_ID_SUFFIX)

PRODUCT_NAME = FaithForm
// The store launch. The build number goes up with every upload to App Store
// Connect, which refuses a second binary under a number it has already seen.
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 2

// The minimum server-supported client build. The server refuses anything older,
// so this is a fact about compatibility rather than a display string.
//
// Deliberately **not** CURRENT_PROJECT_VERSION: an App Store upload bumps that
// for reasons that have nothing to do with the API, and tying the two together
// would make every resubmission look like a protocol change.
FAITHFORM_CLIENT_BUILD = 1

// ---------------------------------------------------------------------------
// Apple Pay
// ---------------------------------------------------------------------------
//
// In-app gifts need Apple Pay (guideline 3.2.1(vi)), and Apple Pay needs the
// `com.apple.developer.in-app-payments` entitlement naming a merchant ID that
// is registered to the signing team. A provisioning profile without that
// capability **fails to sign** — so the entitlement cannot simply be declared
// for everyone.
//
// FAITHFORM_ENABLE_APPLE_PAY is the switch, and it chooses both halves together:
//
//   * which entitlements file Staging and Release sign with (project.yml), and
//   * whether the app is told a merchant ID at all (Info.plist).
//
// Off (the default): the plain entitlements, no merchant ID, and every gift
// goes to the church's give page in Safari. A personal team signs this fine.
//
// On: the Apple Pay entitlements, the merchant ID from Staging/Release, and an
// approved church's gifts happen in the app. Set it on the machine that
// archives store and TestFlight builds, once `merchant.io.faithform.app` is
// registered and the FaithForm team's profile carries the capability:
//
//     apps/faithform-ios/App/Configuration/Local.xcconfig
//     FAITHFORM_ENABLE_APPLE_PAY = YES
//
// The two can never disagree: a merchant ID reaches the app only through the
// same switch that adds the entitlement, so a build cannot offer Apple Pay it
// is not entitled to, and Debug — which signs with no entitlements at all —
// sets no merchant ID to be switched on.
FAITHFORM_ENABLE_APPLE_PAY = $(FAITHFORM_ENABLE_APPLE_PAY:default=NO)

FAITHFORM_ENTITLEMENTS_NO = App/Resources/FaithForm.entitlements
FAITHFORM_ENTITLEMENTS_YES = App/Resources/FaithForm-ApplePay.entitlements
FAITHFORM_ENTITLEMENTS = $(FAITHFORM_ENTITLEMENTS_$(FAITHFORM_ENABLE_APPLE_PAY))

FAITHFORM_APPLE_PAY_MERCHANT_ID_FOR_NO =
FAITHFORM_APPLE_PAY_MERCHANT_ID_FOR_YES = $(FAITHFORM_APPLE_PAY_MERCHANT_ID)
FAITHFORM_APPLE_PAY_MERCHANT_ID_IN_APP = $(FAITHFORM_APPLE_PAY_MERCHANT_ID_FOR_$(FAITHFORM_ENABLE_APPLE_PAY))
