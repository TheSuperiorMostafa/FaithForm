// Copy to `Local.xcconfig` — which is gitignored — and fill in your own.
//
// Both values are yours and neither is a secret. They are kept out of the
// repository because a Team ID identifies an Apple account, and a bundle
// identifier somebody else registered cannot be used by anyone else anyway.
//
// Find your Team ID at https://developer.apple.com/account under Membership,
// or in Xcode: Settings → Accounts → your account → Manage Certificates.

DEVELOPMENT_TEAM = YOUR_TEAM_ID
// Only if you are not on the FaithForm Apple team.
// FAITHFORM_BUNDLE_ID = com.yourname.faithform

// The identity provider a Debug build signs in against. Both values are
// public by design (Supabase publishes them for clients); they live here only
// so the repository never names one particular project. Use your own project
// — the same values as NEXT_PUBLIC_SUPABASE_URL / the publishable key in the
// web app's .env.local.
FAITHFORM_DEV_SUPABASE_URL = https:/$()/your-project-ref.supabase.co
FAITHFORM_DEV_SUPABASE_ANON_KEY = your-publishable-key

// Where a Debug build loads the account after sign-up. The simulator default
// is http://localhost:3000. A physical iPhone cannot use that: localhost is
// the phone, and even a LAN address needs `pnpm dev:device` plus the Debug
// ATS exception. Point at a reachable HTTPS origin, or at this Mac's LAN IP.
// Debug includes this file last so these lines win over the simulator default.
FAITHFORM_API_ORIGIN = https:/$()/faithform.io
// FAITHFORM_API_ORIGIN = http:/$()/192.168.x.x:3000

// Only on the machine that archives App Store and TestFlight builds, and only
// once the signing team's profile carries the Apple Pay capability for
// merchant.io.faithform.app. Anywhere else it makes signing fail. See
// Base.xcconfig.
// FAITHFORM_ENABLE_APPLE_PAY = YES
