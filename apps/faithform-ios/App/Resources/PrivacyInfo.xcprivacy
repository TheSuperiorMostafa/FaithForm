<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        What FaithForm 1.0 for iPhone collects, and why.

        Bundled automatically: the app target sources everything under App/.
        App Store Connect's privacy answers must say the same thing as this
        file, and https://faithform.io/privacy must say the same as both. A
        change to what the app sends is a change to all three, in one go.

        Third-party SDKs carry their own manifests (Stripe's and StreamChat's
        ship inside their packages), and Xcode merges them into the privacy
        report at archive time. This file describes FaithForm's own code only —
        including what is collected through those SDKs on its behalf, such as
        the messages and attachments Stream delivers, which Stream's own
        manifest does not declare.
    -->

    <!--
        No tracking. No advertising identifier, no analytics or advertising
        SDK, no data shared with a data broker, and nothing combined with
        another company's data. There is no App Tracking Transparency prompt
        because there is nothing to ask about.
    -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <!-- Signing in, and the receipt address for gifts. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeEmailAddress</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!-- The name a person gives at sign-up, shown to churches they join. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeName</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!-- The account ID FaithForm assigns. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeUserID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!--
            Precise location, for two features. **Linked**, because one of
            them is: a manifest has one entry per data type, and the stricter
            answer is the true one.

            * Automatic check-in (linked). When a person who turned it on
              arrives for a service, the attendance attempt sends one fix —
              latitude, longitude and its accuracy — with their session, along
              with the service id, the campus region id, the configuration
              version and an attempt or detection id. The server compares the
              fix with the campus, stores only a band (inside / near / far and
              an accuracy band) and discards the coordinates; the counted
              attendance holds no location. Nothing is sent for a drive past,
              and no location history exists on the device — an unsent
              arrival is kept in the Keychain for at most two hours.
            * Churches near me (not linked on its own). One fix, sent once
              without the session, used for that search and not stored.

            Not used for tracking: never shared, never combined with another
            company's data, and there is no advertising identifier.
        -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePreciseLocation</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!--
            Giving history: the church, fund, amount, time and status of each
            gift, so the app can show a person their own giving and receipts.
        -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePurchaseHistory</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!--
            Payment details, entered in Stripe's own sheet and sent to Stripe
            directly. FaithForm never receives a card number; it is declared
            here because the collection happens inside this app.
        -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePaymentInfo</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!--
            Everything else a person does that a church can see: the churches
            they follow or join, invitations they accept, and check-ins from a
            scanned or typed code or from automatic check-in (church, service,
            time and outcome — never a photo, and for automatic check-in the
            location is declared above). None of Apple's named categories fits
            these.
        -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!--
            Photos a person uploads: their profile photo, a group's cover
            photo (leaders), and photos or videos attached in group chat.
        -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePhotosorVideos</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!--
            Group and direct messages (delivered through Stream), files
            attached to them, and the free-text details of an abuse report.
        -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeOtherUserContent</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>

    <!--
        Required-reason APIs.

        UserDefaults, through @AppStorage, for two display preferences this
        app reads back itself: the light/dark appearance and the presentation
        text size. Nothing else is stored there — credentials, resume
        positions and a pending gift all live in the Keychain.

        Checked, not assumed: no file timestamps, no disk-space queries, no
        system boot time and no active keyboard list. The response cache is in
        memory. An entry is added in the same change that first calls one.
    -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
