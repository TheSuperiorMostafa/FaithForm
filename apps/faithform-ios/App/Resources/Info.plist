<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>FaithForm</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>

    <!--
        Where this build points, and which environment it is.

        Both come from the .xcconfig for the configuration being built, so a
        release build cannot be pointed somewhere by a runtime setting, and a
        staging build cannot silently fall back to production: the origin is
        empty in Staging and Release until someone supplies one, and the app
        fails closed when it is missing.
    -->
    <key>FaithFormAPIOrigin</key>
    <string>$(FAITHFORM_API_ORIGIN)</string>
    <key>FaithFormEnvironmentKey</key>
    <string>$(FAITHFORM_ENVIRONMENT_KEY)</string>
    <key>FaithFormClientBuild</key>
    <string>$(FAITHFORM_CLIENT_BUILD)</string>
    <key>FaithFormAllowDebugControls</key>
    <string>$(FAITHFORM_ALLOW_DEBUG_CONTROLS)</string>

    <!--
        The identity provider, for refreshing a session.

        Both values are **public**: Supabase publishes them for exactly this
        purpose, and neither authorises anything on its own — row-level security
        decides what a token can reach. A service-role key must never appear
        here, and `pnpm scan:secrets` asserts it does not.

        Empty by default. A build with no provider configured cannot refresh a
        session and says so, rather than leaving someone on a spinner.
    -->
    <key>FaithFormSupabaseURL</key>
    <string>$(FAITHFORM_SUPABASE_URL)</string>
    <key>FaithFormSupabaseAnonKey</key>
    <string>$(FAITHFORM_SUPABASE_ANON_KEY)</string>

    <!--
        The Apple Pay merchant ID, or nothing.

        Resolved through FAITHFORM_ENABLE_APPLE_PAY (Base.xcconfig), the same
        switch that adds the in-app-payments entitlement — so a build is told a
        merchant ID only when it is entitled to use one. Empty means no Apple
        Pay, and with no Apple Pay every gift goes to the church's give page in
        Safari: guideline 3.2.1(vi) allows in-app donations only with it.
        Public: a merchant ID is in every signed binary's entitlements anyway.
    -->
    <key>FaithFormApplePayMerchantID</key>
    <string>$(FAITHFORM_APPLE_PAY_MERCHANT_ID_IN_APP)</string>

    <!--
        Local-network HTTP. Release still talks HTTPS to faithform.io; this
        exception does not weaken that. It is what lets a Debug build on a
        physical iPhone reach a laptop running `pnpm dev:device` at a LAN
        address. Debug.xcconfig also sets NSAllowsArbitraryLoads so a raw
        RFC 1918 IP is not still blocked on some iOS versions.

        Deliberately not NSAllowsArbitraryLoads here: that key in a store
        binary is a review question, and Release does not need it.
    -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>

    <!--
        Deep links.

        A custom scheme only. `https` App Links need a verified
        apple-app-site-association file on a domain this repository does not
        establish, so the associated-domains entitlement is deliberately absent
        rather than declared and broken.
    -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleURLName</key>
            <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>faithform</string>
            </array>
        </dict>
    </array>

    <!--
        ====================================================================
        USAGE DESCRIPTIONS

        Exactly two, and each names a feature that exists and a reason a
        person can check against what the app does. Nothing is declared
        "in case we need it later": an undeclared permission is one nobody
        can be asked for by accident, and a declared one is a promise.
        ====================================================================
    -->

    <!--
        When In Use serves two features, and names both.

          * Churches near me (Prompt 5). One foreground fix, taken only after
            the education screen's "Use my location"; the search by name, city
            or postal code needs no permission at all.
          * Automatic check-in. The first of its two prompts, raised only after
            the person has read what it does, agreed to it (recorded on the
            server) and tapped Continue on the screen that explains this prompt.

        Neither is ever raised at launch, during sign-in or while browsing.
    -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>FaithForm uses your location to show churches near you and, if you turn on automatic check-in, to notice when you arrive for a service. It never keeps a record of where you have been.</string>

    <!--
        Automatic check-in (1.0). Shown second, from the screen that explains
        why "all the time" is needed, and only after When In Use was granted.

        What it enables is region monitoring: iOS watches the circle round each
        campus of the person's own churches and wakes FaithForm when they cross
        it — relaunching it in the background if it was closed, which is why
        When In Use is not enough. There is no continuous location and no
        `UIBackgroundModes` entry (see below).

        Precise location is required: approximate location turns region
        monitoring off entirely, and a temporary full-accuracy grant lasts only
        while the app is open, so the status screen sends someone with Precise
        Location off to Settings rather than asking for a temporary grant that
        could never deliver an arrival. `NSLocationTemporaryUsageDescriptionDictionary`
        is therefore not declared.
    -->
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>FaithForm checks you in when you arrive at your church, even if the app is closed. It only ever looks at whether you are near a place your church set up, and never where else you go.</string>

    <!--
        QR check-in (Prompt 8). Asked only after an explicit tap on "Scan the
        code" — never at launch, never during onboarding. There is no photo
        library access and no way to save a frame.
    -->
    <key>NSCameraUsageDescription</key>
    <string>FaithForm reads the check-in code your church puts on the screen. It never takes or saves a photo.</string>

    <!--
        Saving a photo from a group chat. StreamChat's image viewer hands the
        image itself to the share sheet, whose "Save Image" writes to Photos —
        and without this key that tap terminates the app. Add-only: nothing
        reads the library (profile and chat photos come through PhotosPicker
        and the file importer, which need no permission).
    -->
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>FaithForm saves a photo from a group chat to your library when you choose Save Image.</string>

    <!--
        Deliberately absent:

          * NSPhotoLibraryUsageDescription — nothing reads the library; photos
            are chosen through PhotosPicker, which needs no permission.
          * NSMicrophoneUsageDescription — nothing records audio.
          * NSContactsUsageDescription — nothing reads contacts.
          * NSUserTrackingUsageDescription — there is no tracking to ask about.
          * NSFaceIDUsageDescription — nothing uses biometrics.
          * UIBackgroundModes — automatic check-in does not need one. Region
            monitoring relaunches the app for a crossing without any
            background mode, and declaring `location` would enable the
            continuous updates this app deliberately does not do.
          * Push is declared as an entitlement but never prompted for: it is
            1.1. Automatic check-in's notifications are *local* — scheduled
            on the phone, needing no entitlement and no usage string — and
            their permission is asked for on the last setup screen, never at
            launch.
    -->

    <!--
        The launch screen is the loading screen's first frame: the same ground
        and the same mark, at the same size and in the same place, so launch
        hands over to `LaunchLoadingView` with nothing visibly changing. It used
        to be a flash of AccentColor followed by a large spinner on a different
        colour, which read as two separate loading screens.
    -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
        <key>UIImageName</key>
        <string>LaunchMark</string>
        <key>UIImageRespectsSafeAreaInsets</key>
        <false/>
    </dict>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
