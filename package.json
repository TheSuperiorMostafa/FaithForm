{
  "name": "faithform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.mjs,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/**/*.test.ts tests/security/**/*.test.ts tests/policies/**/*.test.ts",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:security": "tsx --test tests/security/**/*.test.ts",
    "test:policies": "tsx --test tests/policies/**/*.test.ts",
    "test:database": "tsx --test tests/database/**/*.test.ts",
    "test:concurrency": "node scripts/run-attendance-concurrency.mjs",
    "test:contract": "tsx --test tests/unit/mobile-contract.test.ts",
    "test:migrations": "node scripts/verify-migration-baseline.mjs",
    "pilot:readiness": "node scripts/pilot-readiness.mjs",
    "pilot:rehearse": "./scripts/rehearse-migrations.sh",
    "pilot:plans": "node --import tsx --test tests/database/query-plans.test.ts",
    "pilot:seed": "node scripts/seed-pilot-fixtures.mjs",
    "audit:prod": "node scripts/audit-production.mjs",
    "benchmark:dashboard": "node scripts/benchmark-dashboard-performance.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "security:drift": "node scripts/security-drift-report.mjs",
    "db:rehearse": "node scripts/apply-versioned-migrations.mjs",
    "test:database-security": "node scripts/run-database-security-tests.mjs",
    "ci:verify": "pnpm lint && pnpm typecheck && pnpm verify:generated && pnpm test && pnpm test:migrations && pnpm scan:secrets && pnpm build",
    "db:check": "node scripts/check-migrations.mjs",
    "check:features": "node scripts/check-feature-guards.mjs",
    "db:sermon": "node scripts/apply-sermon-migration.mjs",
    "db:stripe": "node scripts/apply-stripe-migration.mjs",
    "db:onboarding": "node scripts/apply-onboarding-migration.mjs",
    "db:giving-enhancements": "node scripts/apply-giving-enhancements-migration.mjs",
    "db:giving-branding": "node scripts/apply-giving-branding-migration.mjs",
    "validate:themes": "node scripts/validate-slide-themes.mjs",
    "generate:pwpt-themes": "node scripts/generate-pwpt-theme-manifest.mjs",
    "import:themes": "node scripts/import-slide-themes.mjs",
    "import:pwpt-themes": "node scripts/generate-pwpt-theme-manifest.mjs && node scripts/import-slide-themes.mjs data/pwpt-themes-manifest.json",
    "db:slide-themes": "node scripts/apply-slide-themes-migration.mjs",
    "db:bible-text": "node scripts/apply-bible-text-migration.mjs",
    "db:social-assets": "node scripts/apply-social-assets-migration.mjs",
    "db:rate-limits": "node scripts/apply-rate-limits-migration.mjs",
    "db:stream-relay": "node scripts/apply-stream-relay-migration.mjs",
    "db:stream-production": "node scripts/apply-stream-production-migration.mjs",
    "db:stream-scheduling": "node scripts/apply-stream-scheduling-migration.mjs",
    "db:youtube-live": "node scripts/apply-youtube-live-integration-migration.mjs",
    "db:feature-reason": "node scripts/apply-feature-reason-migration.mjs",
    "db:team-access": "node scripts/apply-team-access-migration.mjs",
    "db:attendance-follow-up": "node scripts/apply-attendance-follow-up-migration.mjs",
    "db:email-queue": "node scripts/apply-announcement-email-queue-migration.mjs",
    "db:media-library": "node scripts/apply-media-library-migration.mjs",
    "db:follow-up-log": "node scripts/apply-follow-up-log-migration.mjs",
    "db:church-sites": "node scripts/apply-church-sites-migration.mjs",
    "db:church-themes": "node scripts/apply-church-slide-themes-migration.mjs",
    "db:domains": "node scripts/apply-domain-requests-migration.mjs",
    "seed:demo-sites": "node scripts/seed-demo-sites.mjs",
    "storage:buckets": "node scripts/ensure-storage-buckets.mjs",
    "import:bible": "node scripts/import-bible-translations.mjs",
    "repair:facebook": "node scripts/repair-facebook-integrations.mjs",
    "verify:youtube-ingest": "node scripts/verify-youtube-ingest.mjs",
    "contract:generate": "tsx scripts/generate-contract.mjs",
    "contract:check": "tsx scripts/generate-contract.mjs --check",
    "design:generate": "node scripts/generate-design-tokens.mjs",
    "design:check": "node scripts/generate-design-tokens.mjs --check",
    "localization:check": "node scripts/verify-localization-parity.mjs",
    "ios:build": "cd apps/faithful-ios && swift build",
    "ios:build:device": "./scripts/build-ios-device.sh",
    "ios:app:generate": "cd apps/faithful-ios && xcodegen generate --spec project.yml",
    "ios:app:build": "./scripts/build-ios-app.sh",
    "ios:app:test": "./scripts/build-ios-app.sh --test",
    "android:staging": "cd apps/faithful-android && ./gradlew :app:assembleStaging",
    "android:release": "cd apps/faithful-android && ./gradlew :app:assembleRelease",
    "ios:test": "cd apps/faithful-ios && swift test",
    "android:test": "cd apps/faithful-android && ./gradlew test --no-daemon --console=plain",
    "android:build": "cd apps/faithful-android && ./gradlew :app:assembleDebug --no-daemon --console=plain",
    "verify:generated": "pnpm contract:check && pnpm design:check && pnpm localization:check",
    "db:faithful-push": "node scripts/apply-faithful-push-migration.mjs",
    "db:communications": "node scripts/apply-communications-migrations.mjs",
    "db:attendance": "node scripts/apply-attendance-migration.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.79",
    "@ai-sdk/openai": "^3.0.65",
    "@base-ui/react": "^1.5.0",
    "@google/genai": "^2.10.0",
    "@react-pdf/renderer": "^4.3.0",
    "@stripe/react-stripe-js": "^6.4.0",
    "@stripe/stripe-js": "^9.7.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "ai": "^6.0.191",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "googleapis": "^172.0.0",
    "hls.js": "^1.6.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "next": "15.5.21",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.3",
    "recharts": "^3.8.1",
    "resend": "^6.12.4",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^8",
    "eslint-config-next": "15.5.21",
    "pg": "^8.21.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "4.20.6",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.18",
      "postcss": "8.5.26",
      "sharp": "0.35.3"
    },
    "patchedDependencies": {
      "image-size@1.2.1": "patches/image-size@1.2.1.patch"
    }
  }
}
