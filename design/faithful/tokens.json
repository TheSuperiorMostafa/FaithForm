{
  "$schema": "./tokens.schema.json",
  "version": "1.0.0",
  "name": "Faithful",
  "description": "Canonical, platform-neutral design tokens for the Faithful visitor app. SwiftUI and Compose each render native components from these values; no UI code is shared. Generated constants live in the native projects and are verified by scripts/generate-design-tokens.mjs --check.",

  "direction": {
    "voice": "Premium, warm, welcoming, unmistakably a place rather than a product.",
    "hierarchy": "Editorial. A screen leads with one confident idea, not a grid of equal cards.",
    "surfaces": "Calm warm neutrals. Depth is used to separate meaning, never for decoration.",
    "accent": "A single restrained gold, reserved for what the person should act on or notice.",
    "restraint": "No cheap gradients, no glass stacks, no tiny type, no borrowed social-feed layouts."
  },

  "color": {
    "light": {
      "brandPrimary": "#002D5F",
      "brandAccent": "#C5A059",
      "brandAccentSoft": "#EBAA5F",

      "background": "#F8F7F4",
      "surface": "#FFFFFF",
      "surfaceRaised": "#FFFFFF",
      "surfaceSunken": "#F0EDE6",
      "surfaceInverse": "#002D5F",

      "contentPrimary": "#002D5F",
      "contentSecondary": "#4A5568",
      "contentMuted": "#6B7280",
      "contentInverse": "#FFFFFF",
      "contentOnAccent": "#002D5F",

      "border": "#DDD9D0",
      "borderStrong": "#C4BFB4",
      "divider": "#EAE7E0",

      "destructive": "#B42318",
      "destructiveContent": "#FFFFFF",
      "success": "#0F7B4F",
      "successContent": "#FFFFFF",
      "warning": "#B54708",
      "warningContent": "#FFFFFF",
      "live": "#D92D20",
      "liveContent": "#FFFFFF",

      "focusRing": "#C5A059",
      "overlayScrim": "#002D5F29",
      "skeletonBase": "#EAE7E0",
      "skeletonSheen": "#F5F3EF"
    },
    "dark": {
      "brandPrimary": "#C5A059",
      "brandAccent": "#C5A059",
      "brandAccentSoft": "#EBAA5F",

      "background": "#0A1628",
      "surface": "#0F2040",
      "surfaceRaised": "#16294B",
      "surfaceSunken": "#061020",
      "surfaceInverse": "#F0EDE6",

      "contentPrimary": "#F0EDE6",
      "contentSecondary": "#C3CAD6",
      "contentMuted": "#9CA3AF",
      "contentInverse": "#002D5F",
      "contentOnAccent": "#002D5F",

      "border": "#22375E",
      "borderStrong": "#33507F",
      "divider": "#1A3560",

      "destructive": "#F97066",
      "destructiveContent": "#2A0907",
      "success": "#4ADE80",
      "successContent": "#04240F",
      "warning": "#FDB022",
      "warningContent": "#2B1804",
      "live": "#F97066",
      "liveContent": "#2A0907",

      "focusRing": "#EBAA5F",
      "overlayScrim": "#00060FA3",
      "skeletonBase": "#16294B",
      "skeletonSheen": "#1E3457"
    }
  },

  "contrast": {
    "note": "Every pairing below is verified by scripts/generate-design-tokens.mjs against WCAG 2.1. Body and secondary text must clear 4.5:1; large display text and non-text borders must clear 3:1.",
    "pairs": [
      { "foreground": "contentPrimary", "background": "background", "minRatio": 4.5 },
      { "foreground": "contentPrimary", "background": "surface", "minRatio": 4.5 },
      { "foreground": "contentSecondary", "background": "background", "minRatio": 4.5 },
      { "foreground": "contentSecondary", "background": "surface", "minRatio": 4.5 },
      { "foreground": "contentMuted", "background": "background", "minRatio": 4.5 },
      { "foreground": "contentOnAccent", "background": "brandAccent", "minRatio": 3.0 },
      { "foreground": "destructiveContent", "background": "destructive", "minRatio": 4.5 },
      { "foreground": "successContent", "background": "success", "minRatio": 4.5 },
      { "foreground": "warningContent", "background": "warning", "minRatio": 4.5 },
      { "foreground": "liveContent", "background": "live", "minRatio": 4.5 },
      { "foreground": "contentInverse", "background": "surfaceInverse", "minRatio": 4.5 }
    ]
  },

  "highContrast": {
    "strategy": "Raise border weight and swap muted content to secondary; never rely on hue alone.",
    "borderWidthMultiplier": 1.5,
    "demoteMutedToSecondary": true,
    "disableDecorativeShadows": true
  },

  "typography": {
    "families": {
      "display": { "preferred": "Fraunces", "fallbacks": ["Georgia", "serif"], "role": "Editorial headlines only" },
      "text": { "preferred": "Inter", "fallbacks": ["system-ui", "sans-serif"], "role": "Everything else" }
    },
    "roles": {
      "displayLarge": { "family": "display", "size": 34, "lineHeight": 40, "weight": 600, "tracking": -0.4 },
      "displayMedium": { "family": "display", "size": 28, "lineHeight": 34, "weight": 600, "tracking": -0.3 },
      "titleLarge": { "family": "text", "size": 22, "lineHeight": 28, "weight": 600, "tracking": -0.2 },
      "titleMedium": { "family": "text", "size": 17, "lineHeight": 24, "weight": 600, "tracking": 0 },
      "body": { "family": "text", "size": 17, "lineHeight": 26, "weight": 400, "tracking": 0 },
      "bodySmall": { "family": "text", "size": 15, "lineHeight": 22, "weight": 400, "tracking": 0 },
      "label": { "family": "text", "size": 13, "lineHeight": 18, "weight": 600, "tracking": 0.2 },
      "caption": { "family": "text", "size": 12, "lineHeight": 16, "weight": 400, "tracking": 0.2 }
    },
    "scaling": {
      "respectPlatformTextSize": true,
      "minScale": 0.85,
      "maxScale": 2.0,
      "note": "iOS Dynamic Type and Android fontScale both drive these roles. Layouts must reflow, never truncate body text, and never clip a touch target at maxScale."
    }
  },

  "spacing": { "xs": 4, "sm": 8, "md": 12, "base": 16, "lg": 24, "xl": 32, "xxl": 48, "xxxl": 64 },

  "layout": {
    "screenPaddingHorizontal": 20,
    "screenPaddingVertical": 16,
    "contentMaxWidth": 640,
    "sectionGap": 32,
    "listItemGap": 12,
    "gridGutter": 16
  },

  "radius": { "none": 0, "sm": 8, "md": 12, "lg": 16, "xl": 24, "pill": 999 },

  "border": { "hairline": 1, "standard": 1.5, "emphasis": 2 },

  "elevation": {
    "none":    { "y": 0, "blur": 0,  "spread": 0,  "opacity": 0.0 },
    "raised":  { "y": 1, "blur": 3,  "spread": 0,  "opacity": 0.06 },
    "card":    { "y": 4, "blur": 12, "spread": -2, "opacity": 0.08 },
    "sheet":   { "y": 8, "blur": 28, "spread": -4, "opacity": 0.14 },
    "note": "Shadow colour is always brandPrimary at the given opacity, never neutral black — a warm surface with a grey shadow reads as dirty."
  },

  "icon": { "sizeSmall": 16, "sizeMedium": 20, "sizeLarge": 24, "sizeHero": 32, "strokeWidth": 1.75 },

  "media": {
    "aspectPoster": "4:5",
    "aspectWide": "16:9",
    "aspectSquare": "1:1",
    "cornerRadius": 16,
    "placeholderTone": "surfaceSunken",
    "note": "Artwork supplied by later prompts. Nothing here ships placeholder imagery."
  },

  "touchTarget": { "minimum": 44, "recommended": 48, "note": "44pt is the iOS floor and 48dp the Android floor; both are satisfied by using 48 for primary controls." },

  "motion": {
    "duration": { "instant": 0, "fast": 120, "standard": 220, "slow": 320, "deliberate": 480 },
    "easing": {
      "standard": [0.2, 0.0, 0.0, 1.0],
      "decelerate": [0.0, 0.0, 0.0, 1.0],
      "accelerate": [0.3, 0.0, 1.0, 1.0]
    },
    "rules": [
      "Motion never delays a tap taking effect; feedback is immediate and animation is decoration on top.",
      "Nothing loops indefinitely except an explicit progress indicator.",
      "No parallax, no spring bounce on navigation, no attention-seeking idle animation."
    ],
    "reducedMotion": {
      "strategy": "crossFadeOnly",
      "durationOverride": 100,
      "disableParallax": true,
      "disableAutoplay": true,
      "note": "Reduced motion changes how a transition looks, never whether it happens or what it means."
    }
  },

  "states": {
    "focus":    { "ringWidth": 2, "ringOffset": 2, "color": "focusRing" },
    "pressed":  { "opacity": 0.88, "scale": 0.985 },
    "selected": { "backgroundToken": "surfaceSunken", "borderToken": "brandAccent" },
    "disabled": { "opacity": 0.4, "blockInteraction": true },
    "loading":  { "showSkeleton": true, "minimumVisibleMs": 300, "note": "A skeleton shown for less than this flashes; hold it briefly rather than flicker." },
    "empty":    { "requiresExplanation": true, "note": "An empty state says why it is empty and what to do — never a bare illustration, never invented sample content." },
    "offline":  { "bannerToken": "warning", "keepCachedContentVisible": true, "note": "Cached content stays readable and is labelled as such. Never fabricate a result to fill a screen." },
    "stale":    { "labelRequired": true, "note": "Content older than its freshness window is shown with an explicit 'last updated' rather than silently presented as current." },
    "error":    { "bannerToken": "destructive", "requiresRetryAffordance": true }
  }
}
